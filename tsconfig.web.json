{
  // Compila la app para el NAVEGADOR: ESM a dist/web/, que carga index.html con
  // su importmap, sin bundler. Se lanza con `npm run build:web`.
  //
  // Hereda del tsconfig de la app (con DOM) y sólo cambia adónde va la salida.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "dist/web"
  },
  "include": ["src/core", "src/storage", "src/platform", "src/ui"],
  "exclude": ["src/core/tsconfig.json"]
}
