{
  "autoCompactWindow": 283000,

  "hooks": {
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/checks.sh retomar", "timeout": 10 }]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/checks.sh comitear", "timeout": 10 }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/checks.sh editar", "timeout": 120 }]
      }
    ],
    "Stop": [
      {
        "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/checks.sh terminar", "timeout": 300 }]
      }
    ]
  },

  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "network": { "deniedDomains": ["*"] }
  },

  "permissions": {
    "defaultMode": "acceptEdits",

    "allow": [
      "Bash(npm run:*)",
      "Bash(npm test:*)",
      "Bash(npm audit:*)",
      "Bash(npm ls:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git rm:*)",
      "Bash(git mv:*)",
      "Bash(git branch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git switch:*)",
      "Bash(find:*)",
      "Bash(ls:*)",
      "Bash(wc:*)",
      "Bash(rg:*)",
      "Bash(grep:*)",
      "Bash(mkdir:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(sed:*)",
      "Bash(awk:*)",
      "Bash(node:*)",
      "Bash(python3:*)",
      "mcp__Claude_Browser",
      "WebFetch(domain:nodejs.org)",
      "WebFetch(domain:typescriptlang.org)"
    ],

    "ask": [
      "Bash(git checkout:*)",
      "Bash(git stash:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Edit(./.claude/**)",
      "Write(./.claude/**)",
      "Edit(./.claude/agents/**)",
      "Write(./.claude/agents/**)",
      "Edit(./tmp-test/**)",
      "Write(./tmp-test/**)"
    ],

    "deny": [
      "Bash(git push:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(npm i:*)",
      "Bash(npm install:*)",
      "Bash(npm add:*)",
      "Bash(npm uninstall:*)",
      "Bash(npm remove:*)",
      "Bash(npm rm:*)",
      "Bash(npm update:*)",
      "Bash(npm audit fix:*)",
      "Bash(npx:*)",
      "Bash(npm exec:*)",
      "Bash(yarn:*)",
      "Bash(pnpm:*)",
      "Bash(bun:*)",
      "Bash(bunx:*)",
      "Bash(deno:*)",
      "Bash(corepack:*)",
      "Edit(./node_modules/**)",
      "Write(./node_modules/**)",
      "Edit(./package-lock.json)",
      "Write(./package-lock.json)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(//home/ubuntu/.ssh/**)",
      "Read(//home/ubuntu/.aws/**)",
      "Read(//home/ubuntu/.config/gh/**)"
    ]
  }
}
