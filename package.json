{
  "name": "elnotas",
  "description": "Repositorio provisional para un software de notas hecho por y para mi",
  "version": "1.0.0",
  "main": "index.js",
  "imports": {
    "#core/*": {
      "compiled": "./tmp-test/src/core/*.js",
      "default": "./src/core/*.ts"
    },
    "#storage/*": {
      "compiled": "./tmp-test/src/storage/*.js",
      "default": "./src/storage/*.ts"
    },
    "#platform/*": {
      "compiled": "./tmp-test/src/platform/*.js",
      "default": "./src/platform/*.ts"
    },
    "#ui/*": {
      "compiled": "./tmp-test/src/ui/*.js",
      "default": "./src/ui/*.ts"
    }
  },
  "scripts": {
    "test": "node tools/clean-tmp-test.mjs && tsc -p tsconfig.test.json && node tools/require-tests.mjs && node --conditions=compiled --test tmp-test/test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:core": "tsc -p src/core/tsconfig.json --noEmit",
    "check:purity": "node tools/check-core-purity.mjs",
    "check:fronteras": "node tools/check-fronteras.mjs",
    "check:extensiones": "node tools/check-extensiones.mjs",
    "build:web": "node tools/clean-dist.mjs && tsc -p tsconfig.web.json",
    "check": "npm run typecheck && npm run typecheck:core && npm run check:purity && npm run check:fronteras && npm run check:extensiones && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IldarTashtekov/ElNotas.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/IldarTashtekov/ElNotas/issues"
  },
  "homepage": "https://github.com/IldarTashtekov/ElNotas#readme",
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^6.0.3"
  }
}
